# Hugging Face token with access to the 44ai datasets (needed by `make install`).
# Request access on the dataset pages, or contact frederic.odermatt@44ai.ch.
HF_TOKEN=

# Only needed for the systems you evaluate.
KLARA_API_URL=
KLARA_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
SONIOX_API_KEY=
# Azure Speech / Microsoft Foundry resource key + endpoint ("Keys and Endpoint"
# page). Create the resource in a region serving MAI-Transcribe-2: eastus,
# westus, westus2, northeurope, centralindia or southeastasia.
MAI_TRANSCRIBE_ENDPOINT=
MAI_TRANSCRIBE_API_KEY=
# OpenAI-compatible endpoint of a vLLM server running Nemotron 3.5 Transcribe, started as its model
# card describes, for example http://127.0.0.1:8000/v1.
NEMOTRON_API_URL=
CORTI_CLIENT_ID=
CORTI_CLIENT_SECRET=
CORTI_TENANT_NAME=
# Optional: Keycloak realm when it differs from the tenant name.
CORTI_AUTH_TENANT_NAME=
CORTI_ENVIRONMENT=eu
